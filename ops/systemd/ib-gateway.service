[Unit]
Description=Interactive Brokers Gateway with IBC Automation
Documentation=https://github.com/IbcAlpha/IBC
After=network.target xvfb.service
Wants=xvfb.service

[Service]
Type=forking
User=davidsanker
WorkingDirectory=/home/davidsanker
Environment=DISPLAY=:1
Environment=HOME=/home/davidsanker

# Pre-start checks
ExecStartPre=/bin/bash -c 'pgrep -x Xvfb > /dev/null || { echo "ERROR: Xvfb not running"; exit 1; }'
ExecStartPre=/bin/bash -c 'test -f /home/davidsanker/IBC/config.ini || { echo "ERROR: IBC config missing"; exit 1; }'

# Main startup script
ExecStart=/home/davidsanker/platform/bin/start_ib_gateway.sh

# Health check after startup (wait 120s for port 4002)
ExecStartPost=/bin/bash -c 'for i in {1..24}; do nc -z 127.0.0.1 4002 && exit 0; sleep 5; done; exit 1'

# Graceful shutdown
ExecStop=/usr/bin/pkill -f "java.*ibgateway"
ExecStop=/bin/sleep 5

# Auto-restart on failure
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600

# Resource limits
MemoryLimit=2G
CPUQuota=80%

# Logging
StandardOutput=append:/home/davidsanker/platform/logs/ib-gateway/service.log
StandardError=append:/home/davidsanker/platform/logs/ib-gateway/service-error.log
SyslogIdentifier=ib-gateway

[Install]
WantedBy=multi-user.target
