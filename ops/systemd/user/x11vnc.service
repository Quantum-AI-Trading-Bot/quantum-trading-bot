[Unit]
Description=X11VNC Server for IB Gateway Remote Access
Documentation=man:x11vnc(1)
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=davidsanker
Environment=DISPLAY=:1
ExecStart=/usr/bin/x11vnc -display :1 -forever -shared -nopw -rfbport 5900 -noscr -nowf
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
