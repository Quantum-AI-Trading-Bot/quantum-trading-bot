[Unit]
Description=Quantum-Enhanced AI Trading Bot
Documentation=file:///home/davidsanker/platform/docs/OPERATIONS.md
After=ib-gateway.service
Requires=ib-gateway.service

[Service]
Type=simple
User=davidsanker
WorkingDirectory=/mnt/investor/projects/Investor
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:1

# Pre-flight checks
ExecStartPre=/bin/bash -c 'nc -z 127.0.0.1 4002 || { echo "ERROR: IB Gateway API not ready on port 4002"; exit 1; }'
ExecStartPre=/bin/bash -c 'test -d /home/davidsanker/brain-data/apps/investor/quantum_models || { echo "ERROR: Model directory missing"; exit 1; }'
ExecStartPre=/home/davidsanker/platform/bin/healthcheck.sh --api-only

# Main startup
ExecStart=/home/davidsanker/platform/bin/start_trading_bot.sh

# Graceful shutdown (bot handles SIGTERM for position closing)
KillSignal=SIGTERM
TimeoutStopSec=60

# Auto-restart with exponential backoff
Restart=on-failure
RestartSec=60
StartLimitBurst=3
StartLimitIntervalSec=900

# Resource limits
MemoryLimit=3G
CPUQuota=150%

# Logging
StandardOutput=append:/home/davidsanker/platform/logs/trading-bot/service.log
StandardError=append:/home/davidsanker/platform/logs/trading-bot/service-error.log
SyslogIdentifier=trading-bot

[Install]
WantedBy=multi-user.target
