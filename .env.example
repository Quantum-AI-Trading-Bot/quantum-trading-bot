# ============================================================================
# Quantum AI Trading Bot - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#
# SECURITY NOTICE: Never share your .env file or commit it to git
# ============================================================================

# ============================================================================
# TRADING MODE (CRITICAL - SAFETY DEFAULTS)
# ============================================================================
# Options: paper, live
# DEFAULT: paper (always start with paper trading)
TRADING_MODE=paper

# CRITICAL SAFETY SWITCHES (default to FALSE for safety)
ALLOW_LIVE=false                    # Set to true ONLY after extensive paper testing
QUANTUM_EXECUTION_ENABLED=false     # Enable quantum-inspired execution algorithms
TRADING_ENABLED=false               # Master switch for all trading

# ============================================================================
# INTERACTIVE BROKERS CONFIGURATION
# ============================================================================
IBKR_ACCOUNT_ID=DU1234567           # Your IBKR account number
IB_HOST=127.0.0.1                   # IB Gateway host (local default)
IB_PORT=4002                        # Paper trading port (use 7497 for live paper)
CLIENT_ID=401                       # Client ID for this bot instance

# IB Gateway Authentication
# IBKR_PASSWORD=your_password_here   # Optional: if not using IBC auto-login
# IBKR_KEY=your_api_key_here         # For API-based authentication

# ============================================================================
# RISK MANAGEMENT PARAMETERS
# ============================================================================
# Position Sizing
MAX_POSITION_SIZE=0.15              # Max 15% of portfolio in single position
MAX_PORTFOLIO_RISK=0.25             # Max 25% total portfolio risk
MAX_DAILY_LOSS_PCT=0.05             # Stop trading if 5% daily loss

# Confidence Thresholds
MIN_CONFIDENCE=0.75                 # Minimum model confidence to trade
MIN_FORECAST_CONFIDENCE=0.70        # Minimum forecast confidence

# Portfolio Constraints
MAX_OPEN_POSITIONS=20               # Maximum concurrent positions
MIN_CASH_RESERVE_PCT=0.10           # Keep 10% cash minimum

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Model Zoo Settings
MODEL_ZOO_ENABLED=true              # Enable ensemble model system
FORECAST_MODEL=ewma                 # Default forecast model
SIGNAL_MODEL=signal_generator       # Default signal model
ALLOCATION_MODEL=fixed              # Default allocation model

# Learning System
LEARNING_ENABLED=true               # Enable online learning
OUTCOME_TRACKING_ENABLED=true       # Track trade outcomes for learning

# ============================================================================
# EXTERNAL DATA SOURCES (OPTIONAL)
# ============================================================================
# News & Sentiment
# NEWSAPI_KEY=your_newsapi_key_here
# FRED_API_KEY=your_fred_api_key_here
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
# COINGECKO_API_KEY=your_coingecko_key_here

# Alternative Data
# SENTIMENT_API_KEY=your_sentiment_key_here

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# Log Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Locations
LOG_DIR=logs
STATE_DIR=state
VPA_STORAGE_DIR=vpa_storage

# Monitoring
ENABLE_METRICS=true                 # Enable Prometheus metrics
METRICS_PORT=9090                   # Metrics endpoint port

# ============================================================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# ============================================================================
# SMTP Configuration for alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL_FROM=trading-bot@example.com
# ALERT_EMAIL_TO=you@example.com

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
# Performance Tuning
MAX_WORKERS=4                       # Number of parallel workers
CACHE_TTL_SECONDS=3600              # Cache data for 1 hour

# Trading Schedule
TRADING_START_TIME=09:30            # Market open (ET)
TRADING_END_TIME=16:00              # Market close (ET)
TRADING_DAYS=MON,TUE,WED,THU,FRI    # Trading days

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================
DRY_RUN=true                       # Always dry-run by default
DEBUG_MODE=false                    # Enable verbose debug output
PROFILING_ENABLED=false             # Enable performance profiling

# Testing
TEST_MODE=false                     # Enable test mode (uses mock data)
MOCK_IB_CONNECTION=false            # Use mock IB connection for testing

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# ============================================================================
# EMERGENCY CONTROLS
# ============================================================================
# Emergency stop file location (create this file to halt all trading)
EMERGENCY_STOP_FILE=EMERGENCY_STOP

# ============================================================================
# NOTES
# ============================================================================
# 1. Always test in paper trading mode before enabling live trading
# 2. Never share your .env file or commit it to version control
# 3. Use strong, unique passwords for all accounts
# 4. Enable two-factor authentication on your IBKR account
# 5. Monitor your bot regularly, especially when first starting
# 6. Set up email alerts to be notified of trading activity
# 7. Keep backups of your configuration files
# 8. Review your logs regularly for any issues
