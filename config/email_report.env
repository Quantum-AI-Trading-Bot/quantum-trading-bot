# Email Report Configuration
# Generated: 2026-01-22 07:44:00 UTC
# Purpose: Configure email delivery for trading system reports
# SECURITY: This file contains NO secrets or credentials

# ============================================================================
# EMAIL SETTINGS
# ============================================================================

# Destination email address for reports
# CHANGE THIS to your email address
ALERT_EMAIL=david@sanker.at

# Email subject prefix
SUBJECT_PREFIX=[TradingBot]

# ============================================================================
# REPORT CONTENT
# ============================================================================

# Include portfolio snapshot (requires IB Gateway connection)
INCLUDE_PORTFOLIO=true

# Include recent execution receipts
INCLUDE_RECEIPTS=true

# Include last VPA decision
INCLUDE_LAST_VPA=true

# Include bot service status
INCLUDE_SERVICE_STATUS=true

# ============================================================================
# SCHEDULING
# ============================================================================

# Report schedule (for reference - actual schedule in systemd timer)
# Options: daily, hourly, weekly
REPORT_SCHEDULE=daily

# Default time for daily report (in systemd timer format)
# Default: 07:00 local server time
DAILY_REPORT_TIME=07:00

# ============================================================================
# ADVANCED
# ============================================================================

# Maximum age of execution receipts to include (in hours)
RECEIPTS_MAX_AGE_HOURS=48

# Maximum age of VPA artifacts to include (in hours)
VPA_MAX_AGE_HOURS=72

# Incident lookback period (in hours)
INCIDENT_LOOKBACK_HOURS=24
