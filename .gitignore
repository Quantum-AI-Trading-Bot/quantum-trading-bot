# ============================================================================
# Quantum AI Trading Bot - Git Ignore Configuration
# ============================================================================
# This ensures NO secrets, runtime data, or large files are ever committed

# ============================================================================
# SECRETS - NEVER COMMIT THESE
# ============================================================================
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.jks
secrets/
config/api_keys.json
config/backup_config.ini
config/backup_jts.ini
ibc-config.ini

# ============================================================================
# RUNTIME STATE & DATA
# ============================================================================
# Ledgers and trading records
state/ledgers/*.jsonl
state/ledgers/*.json
vpa_storage/*.json
vpa_storage/*.jsonl
execution_receipts/*
execution_receipts/*.json

# Logs (keep directory structure via .gitkeep)
logs/**/*.log
logs/**/*.txt
logs/**/*.json
logs/**/*
!logs/.gitkeep

# Data directories (keep structure, ignore content)
data/**/*
ml/**/*
optimization/**/*
rl/**/*
settlement/**/*
tools/**/*
!data/.gitkeep
!ml/.gitkeep
!optimization/.gitkeep
!rl/.gitkeep
!settlement/.gitkeep
!tools/.gitkeep

# ============================================================================
# PYTHON ARTIFACTS
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
venv.bak/
trading_bot_venv/
.venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ============================================================================
# IDE & EDITOR FILES
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================================================
# TEMPORARY & RUNTIME FILES
# ============================================================================
*.tmp
*.bak
*.backup
*.old
EMERGENCY_STOP
IB_GATEWAY_MANUAL_LOGIN_REQUIRED
*.pid
*.lock

# Archives (may contain sensitive data)
archives/secrets_*/
archives/**/*.tar.gz
archives/**/*.zip
archives/**/*.tgz

# ============================================================================
# MODEL ARTIFACTS (can be regenerated)
# ============================================================================
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors
models/**/*_artifacts/
models/**/checkpoints/
models/**/saved_models/

# ============================================================================
# JUPYTER NOTEBOOKS
# ============================================================================
.ipynb_checkpoints/
*.ipynb

# ============================================================================
# MISCELLANEOUS
#===========
*.log
*.log.*
session.*
*.session
.node_repl_history
